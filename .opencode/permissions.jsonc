  "guard_rules": [
    "No shell/subagent/web/MCP/plugin permissions",
    "Model provider.use denied until separately approved",
    "Human-only/config/shared contracts/upstream/git write denied",
    "Launcher must run at repo root with isolated HOME/XDG and reject symlinks",
    "Agent/session additions can override application rules; do not use --auto or mutate permissions",
    "Rules mirrored in native agent.system; instructions[] is inert in v2.0.12"
  ],
  "enforcement_limits": [
    "Rules plus OS isolation are separate layers; engine probes do not execute agent tools",
    "No human approval is fabricated by initialization",
    "Full model-driven tool loop remains NOT_RUN"
  ]
