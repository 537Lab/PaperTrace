{
  "schema_version": 1,
  "engine_version": "2.0.12",
  "engine_configuration": "opencode.jsonc",
  "not_auto_loaded_by_opencode": true,
  "status": "initialization-proposal-awaiting-human-review",
  "default_read": "deny-except-explicit-or-ask",
  "default_write": "deny-except-owned-build-scope",
  "read_common": [
    ".agent/rules.md", ".opencode/permissions.jsonc", ".opencode/rules.md", "AGENTS.md",
    "LICENSE", "Prompt.md", "README.md", "TEAM_START_HERE.md", "TEAM_WORK_PLAN.md",
    "architecture-blueprint.md", "docs/ai-use-log.yaml", "docs/architecture/*", "docs/ci/gates.md",
    "docs/code-governance/*", "docs/contracts/*", "docs/req/*", "docs/sources/course-compliance.md",
    "docs/team/*", "docs/tooling/opencode-setup.md", "docs/upstream/BASELINE.md",
    "mypy.ini", "opencode.jsonc", "papertrace.pytest.ini", "papertrace.ruff.toml", "pyproject.toml",
    "uv.lock", "requirements-init.lock", "scripts/opencode_support.py", "src/papertrace/__init__.py",
    "src/papertrace/contracts.py", "test/fixtures/contracts/*", "test/offline/test_contracts.py",
    "test/offline/test_gates.py", "test/offline/test_initialization_edges.py",
    "test/offline/test_opencode_configuration.py", "test/offline/test_opencode_workflow.py"
  ],
  "roles": {
    "papertrace-plan": {
      "read_additions": [],
      "write_candidates": [],
      "description": "Read-only planning by default; Build is not allowed without test or plan approval"
    },
    "papertrace-verify": {
      "read_additions": [],
      "write_candidates": [],
      "description": "Read-only verification; may not modify implementation or tests"
    },
    "papertrace-build-A": {
      "read_additions": [
        "src/papertrace/library/*", "test/offline/test_library.py", "test/live/test_library.py",
        "test/fixtures/library/*", "docs/team/designs/module-A/*"
      ],
      "write_candidates": [
        "src/papertrace/library/*", "test/offline/test_library.py", "test/live/test_library.py",
        "test/fixtures/library/*", "docs/team/designs/module-A/*"
      ],
      "description": "A may only modify library source, its own tests/fixtures, and design records"
    },
    "papertrace-build-B": {
      "read_additions": [
        "src/papertrace/retrieval/*", "test/offline/test_retrieval.py", "test/live/test_retrieval.py",
        "test/fixtures/retrieval/*", "docs/team/designs/module-B/*", "src/paperqa/docs.py",
        "src/paperqa/types.py", "src/paperqa/settings.py", "src/paperqa/core.py",
        "src/paperqa/readers.py", "src/paperqa/llms.py", "src/paperqa/prompts.py",
        "src/paperqa/agents/*", "packages/paper-qa-pypdf/src/paperqa_pypdf/reader.py"
      ],
      "write_candidates": [
        "src/papertrace/retrieval/*", "test/offline/test_retrieval.py", "test/live/test_retrieval.py",
        "test/fixtures/retrieval/*", "docs/team/designs/module-B/*"
      ],
      "description": "B's own area is writable; PaperQA2 read-only sources are listed; dependency package sources still require per-item ask"
    },
    "papertrace-build-C": {
      "read_additions": [
        "src/papertrace/review/*", "test/offline/test_review.py", "test/live/test_review.py",
        "test/fixtures/review/*", "docs/team/designs/module-C/*"
      ],
      "write_candidates": [
        "src/papertrace/review/*", "test/offline/test_review.py", "test/live/test_review.py",
        "test/fixtures/review/*", "docs/team/designs/module-C/*"
      ],
      "description": "C may only modify review source, its own tests/fixtures, and design records"
    },
    "papertrace-build-D": {
      "read_additions": [
        "src/papertrace/answer/*", "test/offline/test_answer.py", "test/live/test_answer.py",
        "test/fixtures/answer/*", "docs/team/designs/module-D/*",
        "src/papertrace/retrieval/service.py", "src/papertrace/retrieval/gateway.py"
      ],
      "write_candidates": [
        "src/papertrace/answer/*", "test/offline/test_answer.py", "test/live/test_answer.py",
        "test/fixtures/answer/*", "docs/team/designs/module-D/*"
      ],
      "description": "D may only modify answer source, its own tests/fixtures, and design records; cross-module reads require a human ask"
    },
    "papertrace-build-E": {
      "read_additions": [
        "src/papertrace/reports/*", "test/offline/test_reports.py", "test/live/test_reports.py",
        "test/fixtures/reports/*", "docs/team/designs/module-E/*"
      ],
      "write_candidates": [
        "src/papertrace/reports/*", "test/offline/test_reports.py", "test/live/test_reports.py",
        "test/fixtures/reports/*", "docs/team/designs/module-E/*"
      ],
      "description": "E may only modify reports source, its own tests/fixtures, and design records"
    }
  },
  "protected_paths": [
    "AGENTS.md", "Prompt.md", ".agent/*", ".opencode/*", "opencode.jsonc",
    "src/papertrace/contracts.py", "src/paperqa/*", "packages/*", "tests/*", "pyproject.toml",
    "uv.lock", "LICENSE", "docs/architecture/adr/*", "docs/code-governance/*",
    "docs/team/integration-contract.md", ".local/*", ".git/*", ".venv/*", "*.env", "*.env.*",
    "*auth.json", "*credentials*.json", "*.pem", "*.key"
  ],
  "safe_shell_allowlist": [
    "git status --short", "git status --short --branch", "git diff", "git diff --check",
    "git diff --stat", "git diff --name-only",
    ".venv/bin/python -m pytest -c papertrace.pytest.ini test/offline",
    ".venv/bin/python -m ruff check --config papertrace.ruff.toml src/papertrace test/offline scripts",
    ".venv/bin/python -m mypy --config-file mypy.ini src/papertrace",
    ".venv/bin/python scripts/gates.py --gate schema",
    ".venv/bin/python scripts/opencode_support.py"
  ],
  "guard_rules": [
    "No provider deny policy; no model or credential is configured by this proposal",
    "All tools deny by default; shell asks except the exact offline/check commands above",
    "Plan and Verify cannot edit; Build A-E can edit only their own module/test/fixture/design patterns",
    "Shared, governance, upstream and dependency writes deny; project-source reads outside the common set ask",
    "Model selection/configuration and any real provider cost/data require separate student authorization",
    "Do not use --auto, subagents, plugins, MCP or external directories"
  ],
  "enforcement_limits": [
    "Permission rules do not prove that a human approved a plan; role selection and recorded approval remain procedural",
    "Provider configuration is intentionally left to the student; no private credentials are read or used",
    "Permission API probes test the engine, not model-driven tool execution",
    "Loopback fake-model tool tests do not establish real model quality or student approval",
    "Engine path checks are lexical; preflight rejects symlinks but is not an OS sandbox"
  ]
}
