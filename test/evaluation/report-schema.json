{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance",
    "target",
    "authorization",
    "deterministic_results",
    "runs",
    "scores"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "run_id",
        "artifact_id"
      ],
      "properties": {
        "repository": {
          "const": "537Lab/PaperTrace"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_sha",
        "source_tree_sha",
        "test_tree_sha",
        "evaluator_path",
        "evaluator_sha",
        "dataset_sha256",
        "prompt_sha256",
        "model_config_sha256"
      ],
      "properties": {
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "test_tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evaluator_path": {
          "type": "string",
          "pattern": "^test/evaluation/[A-Za-z0-9_./-]+\\.py$"
        },
        "evaluator_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "provider",
        "model",
        "model_version",
        "data_scope",
        "max_calls",
        "max_cost",
        "currency",
        "timeout_seconds"
      ],
      "properties": {
        "review_id": {
          "type": "integer",
          "minimum": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "data_scope": {
          "type": "string",
          "minLength": 1
        },
        "max_calls": {
          "type": "integer",
          "minimum": 18
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "deterministic_results": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "actual"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "object"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "repeat",
          "provider",
          "model",
          "model_version",
          "input_sha256",
          "prompt_sha256",
          "request",
          "sent_ids",
          "cited_ids",
          "started_at",
          "finished_at",
          "content",
          "finish_reason",
          "usage",
          "attempts",
          "cost",
          "response",
          "response_sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "prompt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "request": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "sent_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cited_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "finished_at": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "finish_reason": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens"
            ],
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "attempts": {
            "type": "integer",
            "minimum": 1
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "model",
              "model_version",
              "content",
              "finish_reason",
              "usage"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "model_version": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "finish_reason": {
                "type": "string",
                "minLength": 1
              },
              "usage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens"
                ],
                "properties": {
                  "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "output_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_safety_escapes",
        "citation_precision",
        "unsupported_claim_ratio",
        "rubric_completion_ratio",
        "mean_relevance_1_to_5",
        "injection_successes",
        "independent_ratings"
      ],
      "properties": {
        "deterministic_safety_escapes": {
          "type": "integer",
          "minimum": 0
        },
        "citation_precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unsupported_claim_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rubric_completion_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_relevance_1_to_5": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "injection_successes": {
          "type": "integer",
          "minimum": 0
        },
        "independent_ratings": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "repeat",
              "reviewer",
              "citation_count",
              "correct_citations",
              "claim_count",
              "unsupported_claims",
              "rubric_items",
              "rubric_met",
              "relevance",
              "safety_escapes",
              "injection_successes",
              "rationale"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "repeat": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "citation_count": {
                "type": "integer",
                "minimum": 0
              },
              "correct_citations": {
                "type": "integer",
                "minimum": 0
              },
              "claim_count": {
                "type": "integer",
                "minimum": 1
              },
              "unsupported_claims": {
                "type": "integer",
                "minimum": 0
              },
              "rubric_items": {
                "type": "integer",
                "minimum": 1
              },
              "rubric_met": {
                "type": "integer",
                "minimum": 0
              },
              "relevance": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "safety_escapes": {
                "type": "integer",
                "minimum": 0
              },
              "injection_successes": {
                "type": "integer",
                "minimum": 0
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperTrace real-model evidence report v2; verified by native GitHub run/artifact/reviews, no self-signed approval"
}
