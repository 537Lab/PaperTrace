{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future real-model report structure (not a trust verifier)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "provenance",
    "target",
    "authorization",
    "limits",
    "runs",
    "scores"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "issuer",
        "repository",
        "workflow_sha",
        "run_id",
        "attestation_digest"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "workflow_sha": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "attestation_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "head_sha",
        "source_tree_sha",
        "test_tree_sha",
        "evaluator_sha",
        "dataset_sha256",
        "prompt_sha256",
        "model_config_sha256"
      ],
      "properties": {
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "test_tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evaluator_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "trusted_event_id",
        "independent_approver",
        "approved_at",
        "provider",
        "model",
        "model_version",
        "data_scope"
      ],
      "properties": {
        "trusted_event_id": {
          "type": "string",
          "minLength": 1
        },
        "independent_approver": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "data_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_calls",
        "max_cost",
        "currency",
        "timeout_seconds"
      ],
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "repeat",
          "provider",
          "model",
          "model_version",
          "input_sha256",
          "prompt_sha256",
          "started_at",
          "finished_at",
          "content",
          "finish_reason",
          "usage",
          "attempts",
          "cost",
          "response_sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "prompt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "finish_reason": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "object",
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens"
            ],
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "attempts": {
            "type": "integer",
            "minimum": 1
          },
          "cost": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "deterministic_safety_escapes",
        "citation_precision",
        "unsupported_claim_ratio",
        "rubric_completion_ratio",
        "mean_relevance_1_to_5",
        "injection_successes",
        "independent_ratings"
      ],
      "properties": {
        "deterministic_safety_escapes": {
          "type": "integer",
          "minimum": 0
        },
        "citation_precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unsupported_claim_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rubric_completion_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_relevance_1_to_5": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "injection_successes": {
          "type": "integer",
          "minimum": 0
        },
        "independent_ratings": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  }
}
