{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "papertrace-plan",
  "update": "disable",
  "share": "disabled",
  "warming": false,
  "snapshots": false,
  "formatter": false,
  "lsp": false,
  "plugins": [],
  "mcp": { "servers": {} },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": ".agent/rules.md", "effect": "allow" },
    { "action": "read", "resource": ".opencode/permissions.jsonc", "effect": "allow" },
    { "action": "read", "resource": ".opencode/rules.md", "effect": "allow" },
    { "action": "read", "resource": "AGENTS.md", "effect": "allow" },
    { "action": "read", "resource": "LICENSE", "effect": "allow" },
    { "action": "read", "resource": "Prompt.md", "effect": "allow" },
    { "action": "read", "resource": "README.md", "effect": "allow" },
    { "action": "read", "resource": "TEAM_START_HERE.md", "effect": "allow" },
    { "action": "read", "resource": "TEAM_WORK_PLAN.md", "effect": "allow" },
    { "action": "read", "resource": "architecture-blueprint.md", "effect": "allow" },
    { "action": "read", "resource": "docs/ai-use-log.yaml", "effect": "allow" },
    { "action": "read", "resource": "docs/architecture/*", "effect": "allow" },
    { "action": "read", "resource": "docs/ci/gates.md", "effect": "allow" },
    { "action": "read", "resource": "docs/code-governance/*", "effect": "allow" },
    { "action": "read", "resource": "docs/contracts/*", "effect": "allow" },
    { "action": "read", "resource": "docs/req/*", "effect": "allow" },
    { "action": "read", "resource": "docs/sources/course-compliance.md", "effect": "allow" },
    { "action": "read", "resource": "docs/team/*", "effect": "allow" },
    { "action": "read", "resource": "docs/tooling/opencode-setup.md", "effect": "allow" },
    { "action": "read", "resource": "docs/upstream/BASELINE.md", "effect": "allow" },
    { "action": "read", "resource": "mypy.ini", "effect": "allow" },
    { "action": "read", "resource": "opencode.jsonc", "effect": "allow" },
    { "action": "read", "resource": "papertrace.pytest.ini", "effect": "allow" },
    { "action": "read", "resource": "papertrace.ruff.toml", "effect": "allow" },
    { "action": "read", "resource": "pyproject.toml", "effect": "allow" },
    { "action": "read", "resource": "uv.lock", "effect": "allow" },
    { "action": "read", "resource": "requirements-init.lock", "effect": "allow" },
    { "action": "read", "resource": "scripts/opencode_support.py", "effect": "allow" },
    { "action": "read", "resource": "src/papertrace/*", "effect": "ask" },
    { "action": "read", "resource": "src/papertrace/__init__.py", "effect": "allow" },
    { "action": "read", "resource": "src/papertrace/contracts.py", "effect": "allow" },
    { "action": "read", "resource": "src/paperqa/*", "effect": "ask" },
    { "action": "read", "resource": "packages/*", "effect": "ask" },
    { "action": "read", "resource": "test/fixtures/contracts/*", "effect": "allow" },
    { "action": "read", "resource": "test/offline/test_contracts.py", "effect": "allow" },
    { "action": "read", "resource": "test/offline/test_gates.py", "effect": "allow" },
    { "action": "read", "resource": "test/offline/test_initialization_edges.py", "effect": "allow" },
    { "action": "read", "resource": "test/offline/test_opencode_configuration.py", "effect": "allow" },
    { "action": "read", "resource": "test/offline/test_opencode_workflow.py", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*auth.json", "effect": "deny" },
    { "action": "read", "resource": "*credentials*.json", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": ".local/*", "effect": "deny" },
    { "action": "read", "resource": "*.local/*", "effect": "deny" },
    { "action": "read", "resource": ".git/*", "effect": "deny" },
    { "action": "read", "resource": "*.git/*", "effect": "deny" },
    { "action": "read", "resource": ".venv/*", "effect": "deny" },
    { "action": "read", "resource": "*.venv/*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status --short", "effect": "allow" },
    { "action": "shell", "resource": "git status --short --branch", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "git diff --check", "effect": "allow" },
    { "action": "shell", "resource": "git diff --stat", "effect": "allow" },
    { "action": "shell", "resource": "git diff --name-only", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python -m pytest -c papertrace.pytest.ini test/offline", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python -m ruff check --config papertrace.ruff.toml src/papertrace test/offline scripts", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python -m mypy --config-file mypy.ini src/papertrace", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python scripts/gates.py --gate schema", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python scripts/opencode_support.py", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git config *", "effect": "deny" }
  ],
  "agents": {
    "papertrace-plan": {
      "description": "只读计划；精确列计划和测试后停止，等待真实人工审批",
      "mode": "primary",
      "system": "你是 PaperTrace 计划角色。严格按 AGENTS.md 与 Prompt.md 工作。只输出单模块计划、精确路径、测试与验证；不得实现、编辑或替学生/非作者审批。未取得真实审批必须停止。",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "papertrace-verify": {
      "description": "只读检查计划、diff与验证结果；不替作者或学生批准",
      "mode": "primary",
      "system": "你是只读验证角色。按 AGENTS.md 检查指定范围、负例、测试结果和未验证限制。不得编辑、改测试求绿、产生批准或把模拟结果说成真实行为评估。",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }]
    },
    "papertrace-build-A": {
      "description": "Build A；仅 library 模块、独立测试/fixtures及A设计记录",
      "mode": "primary",
      "system": "你是 PaperTrace 模块 A（library）构建角色。学生批准精确计划后，先进入测试准备阶段：只生成/编辑本模块独立 tests/、fixtures/ 和本模块设计记录，严禁写入任何 src/，即使工具 permission 允许源码写入。测试可提交为 proposal PR，并保持 open 且 RED，不为审批而合并。另一位未参与测试实现的学生须通过 GitHub 对具体测试 commit 实际批准；角色选择、会话文字和工具权限不证明真实审批。只有该批准后才可继续本模块 src/实现。实现 PR 必须从测试 head 分支创建，并在描述中写明精确行 \"Test approval PR: #N\"。一次确认本模块范围和精确常用离线命令后，范围内日常编辑不重复逐项请求授权。此行为规则不是身份认证或 OS sandbox。只改A白名单。越界、契约/依赖/安全边界变化即停并请求人工窄授权。",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "src/papertrace/library/*", "effect": "allow" },
        { "action": "edit", "resource": "src/papertrace/library/*", "effect": "allow" },
        { "action": "read", "resource": "test/offline/test_library.py", "effect": "allow" },
        { "action": "edit", "resource": "test/offline/test_library.py", "effect": "allow" },
        { "action": "read", "resource": "test/live/test_library.py", "effect": "allow" },
        { "action": "edit", "resource": "test/live/test_library.py", "effect": "allow" },
        { "action": "read", "resource": "test/fixtures/library/*", "effect": "allow" },
        { "action": "edit", "resource": "test/fixtures/library/*", "effect": "allow" },
        { "action": "read", "resource": "docs/team/designs/module-A/*", "effect": "allow" },
        { "action": "edit", "resource": "docs/team/designs/module-A/*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "deny" }, { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*auth.json", "effect": "deny" }, { "action": "read", "resource": "*credentials*.json", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" }, { "action": "read", "resource": "*.key", "effect": "deny" },
        { "action": "read", "resource": ".local/*", "effect": "deny" }, { "action": "read", "resource": "*.local/*", "effect": "deny" },
        { "action": "read", "resource": ".git/*", "effect": "deny" }, { "action": "read", "resource": "*.git/*", "effect": "deny" },
        { "action": "read", "resource": ".venv/*", "effect": "deny" }, { "action": "read", "resource": "*.venv/*", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" }, { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*auth.json", "effect": "deny" }, { "action": "edit", "resource": "*credentials*.json", "effect": "deny" },
        { "action": "edit", "resource": "*.pem", "effect": "deny" }, { "action": "edit", "resource": "*.key", "effect": "deny" },
        { "action": "edit", "resource": ".local/*", "effect": "deny" }, { "action": "edit", "resource": "*.local/*", "effect": "deny" },
        { "action": "edit", "resource": ".git/*", "effect": "deny" }, { "action": "edit", "resource": "*.git/*", "effect": "deny" },
        { "action": "edit", "resource": ".venv/*", "effect": "deny" }, { "action": "edit", "resource": "*.venv/*", "effect": "deny" }
      ]
    },
    "papertrace-build-B": {
      "description": "Build B；仅 retrieval 模块、独立测试/fixtures及B设计记录；上游读取仅限明列文件",
      "mode": "primary",
      "system": "你是 PaperTrace 模块 B（retrieval）构建角色。学生批准精确计划后，先进入测试准备阶段：只生成/编辑本模块独立 tests/、fixtures/ 和本模块设计记录，严禁写入任何 src/，即使工具 permission 允许源码写入。测试可提交为 proposal PR，并保持 open 且 RED，不为审批而合并。另一位未参与测试实现的学生须通过 GitHub 对具体测试 commit 实际批准；角色选择、会话文字和工具权限不证明真实审批。只有该批准后才可继续本模块 src/实现。实现 PR 必须从测试 head 分支创建，并在描述中写明精确行 \"Test approval PR: #N\"。一次确认本模块范围和精确常用离线命令后，范围内日常编辑不重复逐项请求授权。此行为规则不是身份认证或 OS sandbox。只改B白名单。越界、契约/依赖/安全边界变化即停并请求人工窄授权。",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "src/papertrace/retrieval/*", "effect": "allow" },
        { "action": "edit", "resource": "src/papertrace/retrieval/*", "effect": "allow" },
        { "action": "read", "resource": "test/offline/test_retrieval.py", "effect": "allow" },
        { "action": "edit", "resource": "test/offline/test_retrieval.py", "effect": "allow" },
        { "action": "read", "resource": "test/live/test_retrieval.py", "effect": "allow" },
        { "action": "edit", "resource": "test/live/test_retrieval.py", "effect": "allow" },
        { "action": "read", "resource": "test/fixtures/retrieval/*", "effect": "allow" },
        { "action": "edit", "resource": "test/fixtures/retrieval/*", "effect": "allow" },
        { "action": "read", "resource": "docs/team/designs/module-B/*", "effect": "allow" },
        { "action": "edit", "resource": "docs/team/designs/module-B/*", "effect": "allow" },
        { "action": "read", "resource": "src/paperqa/docs.py", "effect": "allow" },
        { "action": "read", "resource": "src/paperqa/types.py", "effect": "allow" },
        { "action": "read", "resource": "src/paperqa/settings.py", "effect": "allow" },
        { "action": "read", "resource": "src/paperqa/core.py", "effect": "allow" },
        { "action": "read", "resource": "src/paperqa/readers.py", "effect": "allow" },
        { "action": "read", "resource": "src/paperqa/llms.py", "effect": "allow" },
        { "action": "read", "resource": "src/paperqa/prompts.py", "effect": "allow" },
        { "action": "read", "resource": "src/paperqa/agents/*", "effect": "allow" },
        { "action": "edit", "resource": "src/paperqa/*", "effect": "deny" },
        { "action": "edit", "resource": "packages/*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" }, { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*auth.json", "effect": "deny" }, { "action": "read", "resource": "*credentials*.json", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" }, { "action": "read", "resource": "*.key", "effect": "deny" },
        { "action": "read", "resource": ".local/*", "effect": "deny" }, { "action": "read", "resource": "*.local/*", "effect": "deny" },
        { "action": "read", "resource": ".git/*", "effect": "deny" }, { "action": "read", "resource": "*.git/*", "effect": "deny" },
        { "action": "read", "resource": ".venv/*", "effect": "deny" }, { "action": "read", "resource": "*.venv/*", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" }, { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*auth.json", "effect": "deny" }, { "action": "edit", "resource": "*credentials*.json", "effect": "deny" },
        { "action": "edit", "resource": "*.pem", "effect": "deny" }, { "action": "edit", "resource": "*.key", "effect": "deny" },
