        { "action": "read", "resource": "test/offline/test_review.py", "effect": "allow" }, { "action": "edit", "resource": "test/offline/test_review.py", "effect": "allow" },
        { "action": "read", "resource": "test/live/test_review.py", "effect": "allow" }, { "action": "edit", "resource": "test/live/test_review.py", "effect": "allow" },
        { "action": "read", "resource": "test/fixtures/review/*", "effect": "allow" }, { "action": "edit", "resource": "test/fixtures/review/*", "effect": "allow" },
        { "action": "read", "resource": "docs/team/designs/module-C/*", "effect": "allow" }, { "action": "edit", "resource": "docs/team/designs/module-C/*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "deny" }, { "action": "read", "resource": "*.env.*", "effect": "deny" },
