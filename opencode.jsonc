        { "action": "read", "resource": ".git/*", "effect": "deny" }, { "action": "read", "resource": "*.git/*", "effect": "deny" },
        { "action": "read", "resource": ".venv/*", "effect": "deny" }, { "action": "read", "resource": "*.venv/*", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" }, { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*auth.json", "effect": "deny" }, { "action": "edit", "resource": "*credentials*.json", "effect": "deny" },
        { "action": "edit", "resource": "*.pem", "effect": "deny" }, { "action": "edit", "resource": "*.key", "effect": "deny" },
        { "action": "edit", "resource": ".local/*", "effect": "deny" }, { "action": "edit", "resource": "*.local/*", "effect": "deny" },
        { "action": "edit", "resource": ".git/*", "effect": "deny" }, { "action": "edit", "resource": "*.git/*", "effect": "deny" },
        { "action": "edit", "resource": ".venv/*", "effect": "deny" }, { "action": "edit", "resource": "*.venv/*", "effect": "deny" }
      ]
    },
    "papertrace-build-D": {
      "description": "Build D; answer module only, with separate tests/fixtures and the D design records",
      "mode": "primary",
      "system": "You are the PaperTrace module D (answer) build role. After the student approves the exact plan, first enter the test-preparation stage: only generate/edit this module's own tests/, fixtures/, and this module's design records, and writing any src/ is strictly forbidden, even when tool permission allows source writes. The tests may be submitted as a proposal PR and kept open and RED, not merged for the sake of approval. Another student who did not take part in the test implementation must actually approve the specific test commit through GitHub; role selection, session text, and tool permissions do not prove real approval. Only after that approval may this module's src/ implementation continue. The implementation PR must be created from the test head branch and must state the exact line \"Test approval PR: #N\" in the description. Once this module's scope and the exact usual offline commands are confirmed once, daily edits within scope do not repeatedly request authorization item by item. This behavioral rule is not identity authentication or an OS sandbox. Only modify the D allowlist. On crossing a boundary or a change of contracts/dependencies/security boundaries, stop and request narrow human authorization.",
