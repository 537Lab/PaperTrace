{
  "$defs": {
    "SourceLocator": {
      "additionalProperties": false,
      "description": "INV-02, INV-04: parser metadata and page/line ranges, never free-form locations.",
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "chunk_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Chunk Id",
          "type": "string"
        },
        "parser_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Parser Name",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Parser Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "chunk_id",
        "parser_name",
        "parser_version"
      ],
      "title": "SourceLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "INV-03, INV-02, INV-04: exact excerpt and provenance only; no accepted/status field.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^snap-[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "document_id": {
      "pattern": "^doc-[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Document Id",
      "type": "string"
    },
    "version_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Version Sha256",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/SourceLocator"
    },
    "excerpt": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Excerpt",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "advisory_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Advisory Summary"
    },
    "upstream_context_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Context Id"
    },
    "evidence_id": {
      "pattern": "^ev-[0-9a-f]{64}$",
      "title": "Evidence Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "document_id",
    "version_sha256",
    "locator",
    "excerpt",
    "retrieved_at"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
